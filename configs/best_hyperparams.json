{
  "_note": "Recherche Optuna sur UN modèle (arch) : les meilleurs paramètres servent ensuite à construire K agents (best_collab_vs_big.json, best_alpha_sweep.json). search_space : une entrée par hyperparamètre (type float / int / categorical). n_workers processus (job array) x n_trials essais chacun.",
  "dataset": "fashion_mnist",
  "arch": "resnet20",
  "loss": "ce",
  "loss_form": "multiplicative",
  "epochs": 20,
  "batch_size": 128,
  "optimizer": "sgd",
  "lr": 0.01,
  "weight_decay": 0.0005,
  "wd_exclude_norm_bias": true,
  "optimizer_kwargs": null,
  "warmup_epochs": 1,
  "augment": true,
  "val_size": 5000,
  "train_subset": null,
  "n_workers": 4,
  "search_space": {
    "lr": {
      "type": "float",
      "low": 0.0001,
      "high": 0.3,
      "log": true
    },
    "weight_decay": {
      "type": "float",
      "low": 1e-05,
      "high": 0.01,
      "log": true
    },
    "optimizer": {
      "type": "categorical",
      "choices": [
        "sgd",
        "adam",
        "adamw"
      ]
    }
  },
  "n_trials": 30,
  "timeout_hours": null,
  "metric": "val_accuracy",
  "sampler": "tpe",
  "pruner": "median",
  "pruner_warmup_epochs": 3,
  "study_seed": 0,
  "precision": "float32",
  "jit": "auto",
  "steps_per_execution": 8,
  "out_dir": "runs",
  "tag": null
}
